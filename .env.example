# ---------------------------------------------------------------------------
# NYS — नारायणपुरी यूथ सोसाइटी | Environment variables
# इस file को ".env" नाम से copy करें और असली values भरें। ".env" कभी commit न करें।
# ---------------------------------------------------------------------------

# --- Database: PostgreSQL (आवश्यक) ---
# Local:  postgresql://USER:PASSWORD@localhost:5432/nys?schema=public
# Cloud:  Neon / Supabase / Railway का connection string यहाँ डालें।
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/nys?schema=public"

# --- App ---
# साइट का public URL (QR code, receipts, share links, SEO में उपयोग होता है)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NYS"

# --- Auth (session JWT) ---
# एक मज़बूत random secret बनाएं, जैसे: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Seed admin (npm run db:seed इन्हें उपयोग करता है) ---
SEED_ADMIN_EMAIL="admin@nys.org"
SEED_ADMIN_PASSWORD="Admin@123"

# --- Payments: Razorpay ---
# keys खाली छोड़ने पर system MOCK mode में चलता है (dev testing के लिए —
# असली पैसा नहीं कटता)। Production में Razorpay Dashboard → API Keys से भरें।
# SECURITY: payment verification हमेशा server-side signature से होता है।
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Facebook Page feed (optional) ---
# कभी Facebook password store न करें — केवल Page Access Token उपयोग करें।
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""
